# ─── Core ────────────────────────────────────────────────────────────────────
# Public origin, used for canonical URLs, Open Graph, sitemap and RSS.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SQLite database file. Created automatically on first run.
DATABASE_PATH=./storage/jacky.db

# ─── Authentication ──────────────────────────────────────────────────────────
# Initial admin account, consumed only by `npm run db:setup`.
ADMIN_EMAIL=jacky@localhost
ADMIN_NAME=Jacky
# Change this before deploying. Minimum 10 characters.
ADMIN_PASSWORD=change-me-please

# Secret used to sign nothing in v1 (sessions are opaque DB tokens) but is
# reserved for future cookie signing. 32+ random chars recommended.
AUTH_SECRET=

# ─── Storage ─────────────────────────────────────────────────────────────────
# Local upload root (relative to project root or absolute).
STORAGE_DIR=./storage/uploads
# Max upload size in megabytes.
MAX_UPLOAD_MB=8
# Optional: when set, uploaded media is served from this public base URL
# (for example an S3/CDN domain) instead of /api/media.
MEDIA_PUBLIC_BASE_URL=
