# Dependencies
node_modules/

# Build output & caches (regenerate with `npm run build`)
.next/
.next-*/
prebuilt/
out/
build/
*.pack
*.pack.gz
*.tsbuildinfo
next-env.d.ts

# QA artefacts
.qa/

# OS / editor
.DS_Store
*.pem

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment — never commit secrets
.env
.env*.local
.vercel

# Runtime state: SQLite database, WAL files and uploaded media
storage/*.db
storage/*.db-shm
storage/*.db-wal
storage/uploads/*
!storage/uploads/.gitkeep

# Backups
storage/backups/
*.tgz
