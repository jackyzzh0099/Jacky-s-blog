{
  "name": "jacky-blog",
  "version": "1.0.0",
  "private": true,
  "description": "Jacky's Blog — a personal technical blog and digital knowledge space.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:init": "tsx scripts/init-db.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset-db.ts",
    "typecheck": "tsc --noEmit",
    "db:setup": "tsx scripts/init-db.ts && tsx scripts/seed.ts",
    "start:deploy": "NODE_OPTIONS=--experimental-sqlite node --experimental-sqlite node_modules/next/dist/bin/next start -H 0.0.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.22",
    "lucide-react": "^0.475.0",
    "mermaid": "^11.6.0",
    "next": "15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-pretty-code": "^0.14.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^3.4.0",
    "tailwind-merge": "^3.0.2",
    "unified": "^11.0.5",
    "zod": "^3.24.2",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "puppeteer-core": "^23.11.1",
    "tailwindcss": "3.4.19",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.5"
  }
}
